{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lumio-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "1003f3c1199a4870a76f7109adeb7b08"
		}
	]
}